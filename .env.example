YAHOO_LEAGUE_ID=              # e.g. 431.l.41083
YAHOO_TEAM_KEY=               # e.g. 431.l.41083.t.6
YAHOO_TOKEN_FILE=.yahoo_token.json    # cached OAuth token, gitignored
# SCORING_FILE=scoring.json   # optional: override league scoring with scoring.example.json
