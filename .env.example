ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Yahoo Fantasy (optional — for /fantasy page)
FANTASY_PLATFORM=yahoo
YAHOO_CONSUMER_KEY=           # register at developer.yahoo.com/apps/create
